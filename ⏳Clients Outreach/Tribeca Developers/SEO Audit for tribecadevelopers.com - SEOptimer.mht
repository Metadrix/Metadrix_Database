.pulse-ring { display: block; border-radius: 40px; height: 40px; width: 40px; position: absolute; animation: 3.5s ease-out 0s infinite normal none running animation-pulse; opacity: 0; border-width: 3px; border-style: solid; border-color: var(--bs-gray-500); }

